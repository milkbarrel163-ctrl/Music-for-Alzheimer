# MusicAlzheimer Environment Configuration
# Copy this file to .env and fill in your actual values

# ==============================================================================
# API Keys and Authentication
# ==============================================================================

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION=your_org_id_here  # Optional
OPENAI_MODEL=gpt-4-turbo-preview  # or gpt-3.5-turbo

# ==============================================================================
# Server Configuration
# ==============================================================================

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development  # development, staging, production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
MCP_WEBSOCKET_PATH=/ws

# ==============================================================================
# Security
# ==============================================================================

# JWT Configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Security
API_KEY=your_api_key_for_external_access
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # seconds

# ==============================================================================
# Audio Processing
# ==============================================================================

# Audio Generation Settings
AUDIO_SAMPLE_RATE=44100
AUDIO_BIT_DEPTH=16
AUDIO_CHANNELS=2  # 1 for mono, 2 for stereo
MAX_AUDIO_DURATION=300  # seconds
AUDIO_OUTPUT_FORMAT=mp3

# Audio Storage
AUDIO_STORAGE_PATH=./backend/assets/music/generated
AUDIO_TEMP_PATH=./backend/temp

# ==============================================================================
# AI and ML Configuration
# ==============================================================================

# GPT Configuration
GPT_MAX_TOKENS=2000
GPT_TEMPERATURE=0.7
GPT_TOP_P=0.9
GPT_FREQUENCY_PENALTY=0.0
GPT_PRESENCE_PENALTY=0.0

# Music Generation AI
MUSIC_AI_MODEL=musicgen-medium  # or your preferred model
MUSIC_AI_DEVICE=cpu  # cpu or cuda

# ==============================================================================
# Database Configuration (Optional - for future use)
# ==============================================================================

# PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/musicalzheimer
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=40

# Redis (for caching/sessions)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
# REDIS_POOL_SIZE=10

# ==============================================================================
# Logging and Monitoring
# ==============================================================================

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_PATH=./backend/logs
LOG_FILE_NAME=musicalzheimer.log
LOG_ROTATION=10 MB  # When to rotate log files
LOG_RETENTION=7 days  # How long to keep old logs

# Monitoring (Optional)
# SENTRY_DSN=your_sentry_dsn_here
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# ==============================================================================
# External Services (Optional)
# ==============================================================================

# Email Service (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@musicalzheimer.app

# Cloud Storage (Optional - for backup)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=musicalzheimer-assets

# Analytics (Optional)
# GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
# MIXPANEL_TOKEN=your_mixpanel_token

# ==============================================================================
# Feature Flags
# ==============================================================================

# Enable/Disable Features
ENABLE_AI_SUGGESTIONS=true
ENABLE_MUSIC_GENERATION=true
ENABLE_SESSION_RECORDING=true
ENABLE_ANALYTICS=false
ENABLE_DEBUG_MODE=true

# ==============================================================================
# Session Configuration
# ==============================================================================

# Session Settings
SESSION_TIMEOUT_MINUTES=45
MAX_CONCURRENT_SESSIONS=10
SESSION_AUTO_SAVE_INTERVAL=60  # seconds

# Patient Safety
MAX_SESSION_DURATION_MINUTES=60
BREAK_REMINDER_INTERVAL_MINUTES=20
VOLUME_LIMIT_PERCENTAGE=85

# ==============================================================================
# Music Library Configuration
# ==============================================================================

# Library Paths
FAMILIAR_MUSIC_PATH=./backend/assets/music/familiar
SOOTHING_MUSIC_PATH=./backend/assets/music/soothing
UPLIFTING_MUSIC_PATH=./backend/assets/music/uplifting

# Library Settings
MAX_LIBRARY_SIZE_GB=10
SUPPORTED_AUDIO_FORMATS=mp3,wav,m4a,ogg
AUTO_SCAN_LIBRARY=true
SCAN_INTERVAL_HOURS=24

# ==============================================================================
# Development Settings
# ==============================================================================

# Development Only
DEV_MODE=true
HOT_RELOAD=true
DEBUG_SQL=false
MOCK_AI_RESPONSES=false  # Use mock responses instead of real AI calls

# Testing
TEST_MODE=false
TEST_DATABASE_URL=sqlite:///./test.db
TEST_AUDIO_PATH=./backend/test/audio

# ==============================================================================
# Localization
# ==============================================================================

# Language and Region
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,zh,ja
TIMEZONE=UTC
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=24h  # 12h or 24h

# ==============================================================================
# Performance
# ==============================================================================

# Caching
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE_MB=100

# Request Limits
MAX_REQUEST_SIZE_MB=50
MAX_UPLOAD_SIZE_MB=100
REQUEST_TIMEOUT_SECONDS=30

# Threading/Processing
WORKER_PROCESSES=4
THREAD_POOL_SIZE=10
ASYNC_POOL_SIZE=100